{
  "name": "wizly-product-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wizly Labs public product demo — frontend-only, seeded, no backend.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5300",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5300",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "design:generate": "node package/generate.mjs",
    "design:check": "node package/generate.mjs --check",
    "tokens:wrap": "node scripts/wrap-family-tokens.mjs",
    "tokens:remap": "node scripts/remap-hybrid-css.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.1"
  }
}
